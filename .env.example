# RewindCast Configuration
# Copy this to .env and fill in your values

# ===== REQUIRED =====
# Get your free Gemini API key at https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# ===== OPTIONAL =====
# Whisper model size: tiny, base, small, medium, large-v3
# Smaller = faster, larger = more accurate
WHISPER_MODEL_SIZE=base

# TTS voice (Microsoft Edge voices)
# Options: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural, etc.
TTS_VOICE=en-US-AriaNeural

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Audiobookshelf Integration (optional) ─────────────────
# AUDIOBOOKSHELF_URL=http://localhost:13378
# AUDIOBOOKSHELF_API_TOKEN=your-api-token-here
